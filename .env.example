# Set for an external PostgreSQL server. Without this, development uses embedded PostgreSQL.
# DATABASE_URL=postgresql://user:password@localhost:5432/utsav
# Enable fictional seed accounts and simulated payment operations ONLY for local evaluation.
DEMO_MODE=true
# Required to explicitly allow embedded PostgreSQL for a local production-build preview.
ALLOW_EMBEDDED_DB=true
APP_ORIGIN=http://127.0.0.1:4317
